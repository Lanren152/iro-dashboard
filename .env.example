APP_NAME=Investment Research OS
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://investment:investment@db:5432/investment
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MODEL_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
RESEARCH_CYCLE_MINUTES=60
AUTO_SEED=true
DEMO_MODE=true
API_BASE_URL=http://backend:8000

# Real A-share data
# Provider: "akshare" (free, no token) or "tushare" (paid, needs TUSHARE_TOKEN)
DATA_PROVIDER=akshare
# YYYYMMDD report period for earnings forecasts; empty=auto
AKSHARE_REPORT_DATE=
# % pre-increase / pre-decrease thresholds that trigger the financial deep-dive
AKSHARE_FORECAST_MIN_PRE=50.0
AKSHARE_FORECAST_MAX_PRE=-10.0
# Cap on companies deep-dived per sync
AKSHARE_MAX_DEEP_DIVE=300

TUSHARE_TOKEN=
TUSHARE_API_URL=http://api.tushare.pro
REAL_DATA_SYNC_ENABLED=false
REAL_DATA_SYNC_MINUTES=60
